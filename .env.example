# ===================================================
# Supermarket Ops Agent - Environment Configuration
# ===================================================

# Telegram Bot Credentials
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
WEBHOOK_URL=

# LLM Configuration (OpenAI, Gemini, LiteLLM, Groq, Anthropic, or Local)
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# Database URL (SQLite or PostgreSQL)
DATABASE_URL=sqlite:///./supermarket.db
# For PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/supermarket_db

# Shop Profile Defaults
DEFAULT_SHOP_NAME=Sri Lakshmi Stores
DEFAULT_GSTIN=33AAAAA0000A1Z5
DEFAULT_SHOP_ADDRESS=12 Bazaar Street, Anna Nagar, Chennai, Tamil Nadu - 600040
DEFAULT_SHOP_PHONE=+91 98765 43210
DEFAULT_PAYMENT_MODE=UPI

# Application Settings
PORT=8000
DEBUG=True
